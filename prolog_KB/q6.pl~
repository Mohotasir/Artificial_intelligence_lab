% ---------- Designations ----------
role(mr_rahman, ceo).
role(anwar, chairman).
role(imran, head_engineering).
role(kamran, head_product).
role(farzana, head_hr).
role(nisha, board_intern).
role(tanvir, board_intern).
role(ayaan, junior_developer).
role(rida, product_analyst).
role(sara, research_assistant).

% ---------- Supervisory and mentorship links ----------
supervises(mr_rahman, imran).
supervises(mr_rahman, kamran).
supervises(mr_rahman, farzana).
supervises(anwar, mr_rahman).

manages(imran, ayaan).
manages(kamran, rida).

mentors(anwar, nisha).
mentors(anwar, tanvir).
mentors(tanvir, sara).

% ---------- Family link ----------
brother(anwar, mr_rahman).

% ---------- Authority relations ----------
boss(X, Y) :- supervises(X, Y).
boss(X, Y) :- manages(X, Y).
boss(X, Y) :- mentors(X, Y).

% ---------- Recursive seniority ----------
senior(X, Y) :- boss(X, Y).
senior(X, Y) :- boss(X, Z), senior(Z, Y).

% ---------- Colleague (same supervisor) ----------
colleague(X, Y) :-
    supervises(S, X),
    supervises(S, Y),
    X \= Y.

% ---------- Connection through hierarchy or mentorship ----------
connected(X, Y) :- boss(X, Y).
connected(X, Y) :- boss(Y, X).
connected(X, Y) :- boss(X, Z), connected(Z, Y).
connected(X, Y) :- boss(Y, Z), connected(Z, X).

% ---------- Team list using findall ----------
team_list(X, List) :-
    findall(Y, supervises(X, Y), List).
